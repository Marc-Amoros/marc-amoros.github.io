# Dependencias y carpetas que se generan solas al compilar.
# GitHub las vuelve a crear en cada despliegue, no hace falta subirlas.
node_modules/
dist/
.astro/

# Sistema y ajustes locales de tu Mac
.DS_Store
.claude/

# Por si se copian originales a la raíz (capturas, exportaciones, vídeos en
# bruto): la web usa las copias optimizadas de public/assets, y GitHub rechaza
# cualquier archivo de más de 100 MB.
/*.png
/*.jpg
/*.jpeg
/*.mov
/*.mp4

# Restos de trabajo que no forman parte de la web.
/_anterior/
/Inter/
