---
import Contacto from '../components/Contacto.astro';
import { salidasExternas } from '../lib/ajustes.js';
import { conVersion } from '../lib/version.js';
import { letraM } from '../lib/letra-m.js';
/* Esqueleto común de las tres clases de página. Antes la barra, el pie y el
   botón flotante estaban copiados en index.html, proyecto.html y
   articulo.html; ahora se escriben una vez y viajan en todas las páginas. */
const {
  titulo,
  descripcion,
  /* La portada quiere los enlaces a secciones (#sobre-mi); las fichas y los
     artículos, que viven en otra ruta, tienen que volver a la portada. */
  enPortada = false,
  /* detalle.css solo lo necesitan las fichas y los artículos. */
  hojaDetalle = false,
  claseMain = ''
} = Astro.props;

const raiz = enPortada ? '' : '/';
const canonica = new URL(Astro.url.pathname, Astro.site).href;

/* Quién es el autor del sitio, en el vocabulario que Google entiende. Solo
   datos que ya están escritos en algún sitio de la web: nada que no se pueda
   verificar leyendo la propia página. Los enlaces a LinkedIn/Behance/Medium
   siguen el mismo interruptor que el resto del sitio: si están apagados,
   tampoco aparecen aquí. */
const personaJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Marc Amorós Soler',
  url: new URL('/', Astro.site).href,
  jobTitle: 'Diseñador UX/UI',
  image: new URL('/assets/marc.jpg', Astro.site).href,
  ...(salidasExternas && {
    sameAs: [
      'https://www.linkedin.com/in/marcamorossoler/',
      'https://www.behance.net/marcamoros',
      'https://medium.com/@asmarc-uxui'
    ]
  })
};
---
<!DOCTYPE html>
<html lang="es" class="no-js">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>{titulo}</title>
<meta name="description" content={descripcion} />
<meta name="author" content="Marc Amorós Soler" />
<link rel="canonical" href={canonica} />
<!-- Sin condicionar al sistema: el tema por defecto es claro (ver el script
     de más abajo), así que la barra del navegador también parte de blanco.
     El script la pone en negro solo si hay «dark» guardado en localStorage. -->
<meta name="theme-color" content="#ffffff" id="meta-tema" />

<meta property="og:type" content="website" />
<meta property="og:title" content={titulo} />
<meta property="og:description" content={descripcion} />
<meta property="og:image" content={new URL('/assets/marc-og.jpg', Astro.site).href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="628" />
<meta property="og:url" content={canonica} />
<meta property="og:locale" content="es_ES" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={titulo} />
<meta name="twitter:description" content={descripcion} />
<meta name="twitter:image" content={new URL('/assets/marc-og.jpg', Astro.site).href} />

<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='24' fill='%235a13d2'/><text x='50' y='68' font-size='54' font-family='-apple-system,system-ui,sans-serif' font-weight='600' fill='white' text-anchor='middle'>M</text></svg>" />
<link rel="apple-touch-icon" href="/assets/marc-560.jpg" />

<script type="application/ld+json" set:html={JSON.stringify(personaJsonLd)} />

<!-- Inter variable: se pide antes que el CSS para que el texto no cambie
     de tipografía a mitad de la carga. -->
<link rel="preload" href="/assets/fonts/inter-var.woff2" as="font" type="font/woff2" crossorigin />
<link rel="stylesheet" href={conVersion('/css/tokens.css')} />
<link rel="stylesheet" href={conVersion('/css/styles.css')} />
{hojaDetalle && <link rel="stylesheet" href={conVersion('/css/detalle.css')} />}
<slot name="head" />

<!-- Tema: se aplica antes de pintar para que no haya parpadeo al recargar.
     Por defecto la web es clara pase lo que pase en el sistema operativo:
     solo pasa a oscura si quien visita la ha puesto así antes (el botón de
     la barra la guarda en localStorage). -->
<script is:inline>
  (function () {
    document.documentElement.classList.remove('no-js');
    var t = 'light';
    try {
      var guardado = localStorage.getItem('tema');
      if (guardado === 'dark') t = 'dark';
    } catch (e) {}
    document.documentElement.dataset.theme = t;
    var meta = document.getElementById('meta-tema');
    if (meta) meta.content = t === 'dark' ? '#000000' : '#ffffff';
  })();
</script>
<!-- La portada siempre empieza por el hero. Al recargar, o al volver a abrir
     la pestaña, el navegador devolvía la página a donde se había quedado -casi
     siempre el contacto, que es donde acaba-, y la web parecía abrir por ahí.
     Va aquí arriba y no en main.js porque el navegador empieza a recolocar la
     página mientras aún la está leyendo. Solo se respeta la posición al volver
     atrás desde una ficha o un artículo: ahí sí se espera seguir donde estabas. -->
{enPortada && (
  <script is:inline>
    (function () {
      if (!('scrollRestoration' in history)) return;
      history.scrollRestoration = 'manual';
      var clave = 'portada-y';
      var nav = performance.getEntriesByType && performance.getEntriesByType('navigation')[0];
      if (nav && nav.type === 'back_forward') {
        var y = 0;
        try { y = parseInt(sessionStorage.getItem(clave), 10) || 0; } catch (e) {}
        if (y) addEventListener('load', function () { scrollTo({ top: y, behavior: 'instant' }); });
      }
      addEventListener('pagehide', function () {
        try { sessionStorage.setItem(clave, String(Math.round(scrollY))); } catch (e) {}
      });
    })();

    /* Splash: una vez por visita, al entrar por la portada. Se decide aquí,
       antes de pintar, para que el hero no asome un instante por debajo. No
       sale al volver atrás, al llegar a un apartado (/#contacto desde una
       ficha), con menos movimiento ni si el navegador no deja recordar que
       ya se vio: en ese caso saldría en cada visita. */
    (function () {
      if (location.hash) return;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var nav = performance.getEntriesByType && performance.getEntriesByType('navigation')[0];
      if (nav && nav.type === 'back_forward') return;
      try {
        if (sessionStorage.getItem('splash-vista')) return;
        sessionStorage.setItem('splash-vista', '1');
      } catch (e) { return; }
      document.documentElement.dataset.splash = 'on';
    })();
  </script>
)}
</head>

<body>
{enPortada && (
  <>
    <!-- Splash de entrada: la «M» del arte de la portada se dibuja, se rellena
         y la selecciona su caja, con el nombre debajo; luego se funde y el hero
         hace su entrada. Es decoración: oculta a los lectores de pantalla. -->
    <div class="splash" id="splash" aria-hidden="true">
      <div class="splash__marca">
        <svg class="splash__m" viewBox="20 4 580 452" focusable="false">
          <path class="splash__relleno" d={letraM}/>
          <path class="splash__trazo" d={letraM} pathLength="1"/>
          <g class="splash__caja">
            <rect x="46" y="30" width="528" height="400"/>
            {[[46, 30], [310, 30], [574, 30], [46, 230], [574, 230], [46, 430], [310, 430], [574, 430]].map(([x, y]) => (
              <rect class="splash__asa" x={x - 11} y={y - 11} width="22" height="22"/>
            ))}
          </g>
        </svg>
        <span class="splash__nombre">Marc Amorós</span>
      </div>
    </div>
    <!-- Quién manda en la splash. Va en línea y no en main.js: si ese archivo
         tarda o falla, la splash se va igual (el CSS también la apaga solo). -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var splash = document.getElementById('splash');
        if (!splash) return;
        if (root.dataset.splash !== 'on') { splash.remove(); return; }

        /* A los 1,1 s el hero empieza su entrada mientras la splash se funde:
           las dos cosas se solapan y no hay un hueco en blanco entre ellas. */
        var entregada = false;
        function entregar() {
          if (entregada) return;
          entregada = true;
          root.dataset.splash = 'sale';
          var hero = document.getElementById('inicio');
          if (hero) hero.classList.add('overture');
          document.dispatchEvent(new Event('splash:fin'));
        }
        var gestos = ['pointerdown', 'keydown', 'wheel', 'touchstart'];
        function terminar() {
          entregar();
          gestos.forEach(function (t) { removeEventListener(t, saltar); });
          root.removeAttribute('data-splash');
          splash.remove();
        }
        /* Cualquier gesto la quita al momento: nadie tiene que esperarla. */
        function saltar() {
          if (entregada) return;
          splash.classList.add('splash--fuera');
          entregar();
        }

        setTimeout(entregar, 1100);
        setTimeout(terminar, 2600);
        splash.addEventListener('animationend', function (e) {
          if (e.target === splash && e.animationName === 'splash-sale') terminar();
        });
        gestos.forEach(function (t) { addEventListener(t, saltar, { passive: true }); });
      })();
    </script>
  </>
)}
<a class="skip-link" href="#contenido">Saltar al contenido</a>

<header class="nav" id="nav">
  <div class="nav__inner">
    <a class="nav__brand" href={enPortada ? '#inicio' : '/'}>Marc Amorós</a>

    <nav class="nav__nav" aria-label="Principal">
      <ul class="nav__list" id="nav-list">
        <li><a class="nav__link" href={`${raiz}#sobre-mi`}>Sobre mí</a></li>
        <li><a class="nav__link" href={`${raiz}#trayectoria`}>Trayectoria</a></li>
        <li><a class="nav__link" href={`${raiz}#portafolio`}>Portafolio</a></li>
        <li><a class="nav__link" href={`${raiz}#articulos`}>Artículos</a></li>
        {enPortada && <li><a class="nav__link" href="#contacto">Contacto</a></li>}
      </ul>
    </nav>

    <div class="nav__actions">
      <button class="theme-toggle" id="theme-toggle" type="button"
              aria-label="Cambiar entre modo claro y oscuro">
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
             stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
      </button>

      <a class="btn btn--primary nav__cta" href={`${raiz}#contacto`}>Hablemos</a>

      <!-- El menú de móvil vive en todas las páginas, no solo en la
           portada: sin JavaScript hacía falta para verlo, así que quedaba
           gated tras enPortada por descuido, y en fichas y artículos el
           móvil se quedaba sin ninguna forma de navegar (el «Hablemos» y
           los enlaces del nav__list también están ocultos ahí por debajo
           de 48rem). -->
      <button class="nav__burger" id="nav-burger" type="button"
              aria-expanded="false" aria-controls="nav-panel" aria-label="Abrir menú">
        <span></span><span></span>
      </button>
    </div>
  </div>

  <div class="nav__panel" id="nav-panel" hidden>
    <ul>
      <li><a href={`${raiz}#sobre-mi`}>Sobre mí</a></li>
      <li><a href={`${raiz}#trayectoria`}>Trayectoria</a></li>
      <li><a href={`${raiz}#portafolio`}>Portafolio</a></li>
      <li><a href={`${raiz}#articulos`}>Artículos</a></li>
      <li><a href={`${raiz}#contacto`}>Contacto</a></li>
    </ul>
  </div>
</header>

<!-- Fondo oscurecido y difuminado detrás del menú, el mismo tratamiento que
     el ::backdrop de la modal de contacto (.contacto-modal). No es un
     <dialog>, así que aquí se pinta a mano; decorativo, por eso aria-hidden,
     y se cierra al tocarlo, como la modal. Fuera de <header> a propósito: el
     backdrop-filter de la barra convierte a .nav en el contenedor de sus
     descendientes «fixed», y ahí dentro este fondo solo llegaba a cubrir los
     60px de la barra en vez de toda la ventana. -->
<div class="nav__backdrop" id="nav-backdrop" hidden aria-hidden="true"></div>

<main id="contenido" class={claseMain}>
  <slot />
</main>

<footer class="footer">
  <div class="footer__inner">
    <p>© <span id="year">2026</span> Marc Amorós Soler · Diseñado y montado en Barcelona.</p>
    <p><a href={enPortada ? '#inicio' : '/'}>{enPortada ? <>Volver arriba <span class="footer__flecha" aria-hidden="true">↑</span></> : 'Volver a la portada'}</a></p>
  </div>
</footer>

<button class="fab" id="fab" type="button" aria-label="Hablemos: ir a contacto">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
       stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M4 6h16v12H4z"></path><path d="m4 7 8 6 8-6"></path>
  </svg>
  <span class="fab__label">Hablemos</span>
</button>

{!enPortada && (
  <dialog class="contacto-modal" id="contacto-modal" aria-labelledby="contacto-modal-titulo">
    <div class="contact">
      <button class="contacto-modal__cerrar" type="button" aria-label="Cerrar">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
      <Contacto idTitulo="contacto-modal-titulo" conFoto />
    </div>
  </dialog>
)}

<script is:inline src={conVersion('/js/main.js')} defer></script>
<slot name="scripts" />
</body>
</html>
