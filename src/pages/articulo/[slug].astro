---
/* Un artículo por entrada, generado al compilar.
   ------------------------------------------------------------
   El cuerpo viene ya saneado del generador que lo trajo de Medium: solo
   párrafos, titulares, listas, citas e imágenes. Los ids de los titulares se
   ponen aquí, con el mismo algoritmo que usaba el navegador, para que los
   enlaces guardados sigan apuntando al mismo apartado. */
import Base from '../../layouts/Base.astro';
import { ARTICULOS } from '../../data/articulos.js';
import { prepararCuerpo, contarAltsPendientes } from '../../lib/articulo.js';
import { salidasExternas } from '../../lib/ajustes.js';
import { conVersion } from '../../lib/version.js';

export function getStaticPaths() {
  /* Aviso una sola vez por compilación: las imágenes sin pie que siguen sin
     texto alternativo son las únicas que un lector de pantalla no puede
     anunciar de ninguna manera. Se rellenan en src/data/alt-textos.js. */
  const pendientes = contarAltsPendientes();
  if (pendientes.length) {
    console.warn(`\n  [a11y] ${pendientes.length} imagen(es) sin pie y sin texto alternativo:`);
    for (const p of pendientes) console.warn(`         ${p.articulo} -> ${p.imagen}`);
    console.warn('         Rellenalas en src/data/alt-textos.js\n');
  }

  return ARTICULOS.map((articulo, i) => ({
    params: { slug: articulo.slug },
    props: {
      articulo,
      reciente: ARTICULOS[i - 1] ?? null,
      antiguo: ARTICULOS[i + 1] ?? null
    }
  }));
}

const { articulo, reciente, antiguo } = Astro.props;
const { html, titulares } = prepararCuerpo(articulo.html);

/* Un índice de un solo apartado no ayuda a nadie: solo aparece cuando el
   artículo tiene suficientes titulares para que valga la pena saltar. */
const conIndice = titulares.length >= 3;
/* Google corta el título hacia los 60 caracteres. Si con la firma no cabe, se
   queda el titular solo: la firma ya va en la dirección y en la propia página. */
const conFirma = `${articulo.titulo} · Marc Amorós`;
const tituloPagina = conFirma.length > 60 ? articulo.titulo : conFirma;
/* En el índice los titulares escritos enteros en mayúsculas se leen en
   minúscula con inicial: en una columna estrecha las mayúsculas partían cada
   título en tres o cuatro líneas. El titular del artículo no cambia. */
const rotulo = (t) => t === t.toLocaleUpperCase('es') && /\p{Ll}/u.test(t.toLocaleLowerCase('es'))
  ? t.charAt(0) + t.slice(1).toLocaleLowerCase('es')
  : t;
---

<Base
  titulo={tituloPagina}
  descripcion={articulo.sub}
  hojaDetalle={true}
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://cdn-images-1.medium.com" />
    <link rel="dns-prefetch" href="https://cdn-images-1.medium.com" />
  </Fragment>

  <article class="caso" id="post">
    <div class="caso__inner">
      <div class="post">
        <a class="volver" href="/#articulos">Artículos</a>

        <header class="caso__head">
          <span class="eyebrow">Artículo de proceso</span>
          <h1 class="caso__title">{articulo.titulo}</h1>
          <p class="caso__claim">{articulo.sub}</p>
          <p class="post__meta">
            <time datetime={articulo.fecha}>{articulo.fechaLarga}</time>
            <span class="dot-sep" aria-hidden="true">·</span>
            <span>{articulo.minutos} min de lectura</span>
          </p>
        </header>

        <aside class="menu" data-abierto="false" data-solo={conIndice ? undefined : 'true'}
               aria-label="Lectura del artículo">
          <button class="menu__tirador" type="button" aria-expanded="false"
                  aria-controls="menu-lectura"
                  aria-label={conIndice ? 'Apartados y progreso de lectura' : 'Progreso de lectura'}>
            <svg class="menu__anillo" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
              <circle class="menu__pista" cx="20" cy="20" r="17"></circle>
              <circle class="menu__avance" cx="20" cy="20" r="17" pathLength="1"></circle>
            </svg>
            <span class="menu__cifra">{articulo.minutos}</span>
          </button>

          <div class="menu__panel" id="menu-lectura">
            {articulo.proyecto && articulo.proyectoTitulo && (
              <div class="menu__pliegue"><div class="menu__pliegue-i">
                <a class="menu__caso" href={`/proyecto/${articulo.proyecto}/`} style="--i: 0">
                  <span class="menu__caso-k">Documenta el caso</span>
                  <span class="menu__caso-t">{articulo.proyectoTitulo}</span>
                </a>
              </div></div>
            )}

            {conIndice && (
              <nav class="indice" aria-label="Apartados del artículo" data-marca="off">
                <ol class="indice__lista">
                  <li class="indice__marca" aria-hidden="true"></li>
                  {titulares.map((t, n) => (
                    <li>
                      <a class="indice__a" href={`#${t.id}`} style={`--i: ${n + 1}`}>
                        <span class="indice__t">{rotulo(t.texto)}</span>
                      </a>
                    </li>
                  ))}
                </ol>
              </nav>
            )}

            <div class="menu__pliegue"><div class="menu__pliegue-i">
              <div class="menu__pie" style={`--i: ${titulares.length + 1}`}>
                <p class="indice__k">Lectura</p>
                <p class="menu__n"><strong>{articulo.minutos} min</strong> por delante</p>
                <span class="menu__barra"><span class="menu__barra-i"></span></span>
              </div>
            </div></div>
          </div>
        </aside>

        <div class="post__cuerpo" set:html={html} />

        <div class="work-more rise">
          {articulo.proyectoTitulo && (
            <Fragment>
              <p>Este artículo documenta el proceso de {articulo.proyectoTitulo}.</p>
              <a class="btn btn--primary" href={`/proyecto/${articulo.proyecto}/`}>Ver el caso completo</a>
            </Fragment>
          )}
          {salidasExternas && (
            <a class="btn btn--ghost" href={articulo.medium} target="_blank" rel="noopener">Leer el original en Medium</a>
          )}
        </div>

        {(reciente || antiguo) && (
          <nav class="pares" aria-label="Otros artículos">
            {reciente && (
              <a class="par" href={`/articulo/${reciente.slug}/`}>
                <span class="par__k">‹ Más reciente</span>
                <span class="par__t">{reciente.titulo}</span>
              </a>
            )}
            {antiguo && (
              <a class="par par--next" href={`/articulo/${antiguo.slug}/`}>
                <span class="par__k">Más antiguo ›</span>
                <span class="par__t">{antiguo.titulo}</span>
              </a>
            )}
          </nav>
        )}
      </div>
    </div>
  </article>

  <script is:inline slot="scripts" src={conVersion('/js/lectura.js')} defer></script>
</Base>
