---
/* La portada. El cuerpo viene tal cual del index.html original: las tarjetas
   están escritas a mano una a una porque su copy —la insignia, el resumen
   corto, las tres etiquetas que se enseñan— está redactado para la tarjeta y
   no coincide con el de la ficha. Lo único que ha cambiado son los enlaces,
   que ahora apuntan a las rutas nuevas. */
import Base from '../layouts/Base.astro';
import Contacto from '../components/Contacto.astro';
import { salidasExternas, estadoHero, retratoHero, botonesHero, sobreMiCompleto } from '../lib/ajustes.js';

/* La «M» del arte de la portada: un único trazado (sin fuente). Se declara una vez
   y se reutiliza para la cara, para su fondo extruido, para su sombra y para el
   recorte del brillo. */
const letraM = 'M46 30H194L306.1 292.2L426 30H574V38Q574 46 566 46H534Q520 46 520 62V388Q520 414 546 414H553Q560 414 560 421V430H400V421Q400 414 407 414H414Q440 414 440 388V56.2L269 430L124 90.8V388Q124 414 150 414H157Q164 414 164 421V430H58V421Q58 414 65 414H72Q98 414 98 388V62Q98 46 84 46H54Q46 46 46 38Z';
/* Las 16 capas del fondo, de la más lejana (k = 1) a la más cercana a la cara. */
const capasLado = Array.from({ length: 16 }, (_, i) => (16 - i) / 16);

---

<Base
  titulo="Marc Amorós · Diseñador UX/UI"
  descripcion="Marc Amorós, diseñador UX/UI y gráfico en Barcelona. Investigación, prototipado y diseño de interfaces. Portafolio de proyectos y artículos de proceso."
  enPortada={true}
  conMotion={true}
>
  <!-- ============================================================
       Hero
       ============================================================ -->
  <section class="hero" id="inicio" aria-labelledby="inicio-titulo">
    <!-- Malla de puntos: el único adorno de la portada. La dibuja main.js -->
    <canvas class="hero__malla" id="malla" aria-hidden="true"></canvas>

    <div class="hero__inner">
      <div class="hero__texto">
        {estadoHero && (
          <p class="hero__status enter" style="--delay:120ms">
            <span class="hero__dot" aria-hidden="true">💻</span>
            <span>Barcelona · Diseñador de Producto Digital (UX/UI)</span>
          </p>
        )}

        <h1 class="hero__title" id="inicio-titulo">
          <span class="line"><span>Diseño interfaces</span></span>
          <span class="line"><span>que <em>se entienden solas</em></span></span>
        </h1>

        <div class="hero__sub enter" style="--delay:260ms">
          <p>
            Hola, soy Marc Amorós. Creo productos digitales con impacto real, equilibrando
            las necesidades de las personas con las metas de negocio.
          </p>
          <p>
            Aplico metodologías UX y herramientas UI para guiar cada etapa, de la
            investigación al prototipo funcional, respaldando cada decisión con una
            documentación transparente y orientada a resultados.
          </p>
        </div>

        {botonesHero && (
          <div class="hero__actions enter" style="--delay:340ms">
            <a class="btn btn--primary btn--lg btn--hoja" href="#portafolio">Ver portafolio</a>
            <a class="btn btn--ghost btn--lg btn--hoja" href="#contacto">Contactar</a>
          </div>
        )}
      </div>

      <!-- El arte de la portada: una mesa de trabajo de diseño. Una «M» de módulo serif,
           dibujada a mano como un único trazado (sin fuente, sin descarga), en edición:
           sobre su lienzo con rejilla, con guías, la caja de selección con sus asas, la
           medida y el cursor de quien la está tocando, con su nombre. Es decoración: va
           oculta a los lectores de pantalla. Cada grupo es una capa (arte__capa) que
           main.js desplaza un poco con el cursor, y los colores salen de los tokens
           --portada-arte-*, así que sigue al tema. -->
      <div class="hero__arte" data-arte>
        <svg class="arte" viewBox="0 0 640 620" aria-hidden="true" focusable="false">
          <defs>
            <pattern id="arte-rejilla" width="44" height="44" patternUnits="userSpaceOnUse">
              <path d="M44 0H0V44" fill="none"/>
            </pattern>
            <clipPath id="arte-recorte"><rect x="60" y="100" width="520" height="470" rx="46"/></clipPath>
            <path id="arte-m" d={letraM}/>
            <clipPath id="arte-clip-m"><use href="#arte-m"/></clipPath>
            <!-- La luz de tu cursor sobre el lienzo: un brillo suave y, debajo, la
                 rejilla en el acento, que solo asoma dentro del foco (la máscara va
                 en unidades del propio círculo, así que viaja con él). -->
            <radialGradient id="arte-luz-grad">
              <stop offset="0" class="arte__luz-a"/>
              <stop offset="1" class="arte__luz-b"/>
            </radialGradient>
            <pattern id="arte-rejilla-viva" width="44" height="44" patternUnits="userSpaceOnUse">
              <path d="M44 0H0V44" fill="none"/>
            </pattern>
            <radialGradient id="arte-foco-grad">
              <stop offset="0" stop-color="#fff"/>
              <stop offset="0.35" stop-color="#fff" stop-opacity="0.8"/>
              <stop offset="1" stop-color="#fff" stop-opacity="0"/>
            </radialGradient>
            <mask id="arte-foco" maskContentUnits="objectBoundingBox">
              <rect width="1" height="1" fill="url(#arte-foco-grad)"/>
            </mask>
            <linearGradient id="arte-lienzo-grad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" class="arte__lz-a"/>
              <stop offset="1" class="arte__lz-b"/>
            </linearGradient>
            <linearGradient id="arte-gloss" x1="0" y1="0" x2="0.55" y2="1">
              <stop offset="0" class="arte__gloss-a"/>
              <stop offset="0.55" class="arte__gloss-b"/>
            </linearGradient>
            <linearGradient id="arte-tinta-grad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" class="arte__tinta-a"/>
              <stop offset="1" class="arte__tinta-b"/>
            </linearGradient>
            <linearGradient id="arte-brillo" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" class="arte__br-0"/>
              <stop offset="0.5" class="arte__br-1"/>
              <stop offset="1" class="arte__br-0"/>
            </linearGradient>
            <!-- Las sombras son filtros SVG y no filtros CSS: los CSS sobre piezas
                 sueltas de un SVG no los pintan todos los navegadores. -->
            <filter id="arte-desenfoque" x="-10%" y="-10%" width="120%" height="120%">
              <feGaussianBlur stdDeviation="9"/>
            </filter>
            <filter id="arte-elevacion" x="-12%" y="-12%" width="124%" height="140%" color-interpolation-filters="sRGB">
              <feGaussianBlur in="SourceAlpha" stdDeviation="14"/>
              <feOffset dy="26" result="s"/>
              <feFlood class="arte__flood-hoja"/>
              <feComposite in2="s" operator="in" result="sombra"/>
              <feMerge><feMergeNode in="sombra"/><feMergeNode in="SourceGraphic"/></feMerge>
            </filter>
            <filter id="arte-elevacion-ui" x="-30%" y="-40%" width="160%" height="230%" color-interpolation-filters="sRGB">
              <feGaussianBlur in="SourceAlpha" stdDeviation="3"/>
              <feOffset dy="5" result="s"/>
              <feFlood class="arte__flood-ui"/>
              <feComposite in2="s" operator="in" result="sombra"/>
              <feMerge><feMergeNode in="sombra"/><feMergeNode in="SourceGraphic"/></feMerge>
            </filter>
          </defs>

          <!-- Atrás del todo: el lienzo, girado, con su copia de puntos detrás. -->
          <g class="arte__capa arte__capa--lienzo">
            <g transform="rotate(3 306 320)">
              <rect class="arte__marco2" x="46" y="86" width="520" height="470" rx="46"/>
            </g>
            <g transform="rotate(-4 320 335)">
              <g class="arte__hoja" filter="url(#arte-elevacion)">
                <rect class="arte__lienzo" x="60" y="100" width="520" height="470" rx="46"/>
                <g clip-path="url(#arte-recorte)">
                  <rect class="arte__rejilla" x="60" y="100" width="520" height="470"/>
                </g>
                <rect class="arte__gloss" x="60" y="100" width="520" height="470" rx="46"/>
                <rect class="arte__borde" x="60.6" y="100.6" width="518.8" height="468.8" rx="45.4"/>
              </g>
              <!-- La luz de tu cursor sobre el lienzo. Fuera de la hoja para que
                   moverla no obligue a recalcular su sombra; main.js la coloca
                   (cx, cy) donde estás. -->
              <g class="arte__luz" clip-path="url(#arte-recorte)">
                <circle class="arte__luz-brillo" cx="320" cy="335" r="230"/>
                <circle class="arte__luz-rejilla" cx="320" cy="335" r="150" mask="url(#arte-foco)"/>
              </g>
            </g>
          </g>

          <g class="arte__capa arte__capa--guias">
            <line class="arte__guia" pathLength="100" x1="18" y1="150.2" x2="622" y2="150.2"/>
            <line class="arte__guia" pathLength="100" x1="18" y1="513.8" x2="622" y2="513.8"/>
          </g>

          <g class="arte__capa arte__capa--interruptor">
            <g class="arte__pop">
              <g class="arte__sombra-ui" filter="url(#arte-elevacion-ui)" transform="translate(24 98)">
                <rect class="arte__pista" width="62" height="34" rx="17"/>
                <circle class="arte__bola" cx="45" cy="17" r="13"/>
              </g>
            </g>
          </g>

          <!-- La «M» como un sólido: su sombra, el fondo (16 capas que se desplazan
               un poco con el cursor, y eso es lo que da la profundidad), la cara y
               un brillo que la cruza. Debajo, la selección con sus asas y su medida,
               y el destello que deja el brillo al salir de la letra. -->
          <g class="arte__capa arte__capa--m">
            <g transform="translate(38.2 122.9) scale(0.90909)">
              <g class="arte__solido">
                <use href="#arte-m" class="arte__sombra-m" filter="url(#arte-desenfoque)"/>
                {capasLado.map((k) => <use href="#arte-m" class="arte__lado" style={`--k:${k}`}/>)}
                <use href="#arte-m" class="arte__letra"/>
                <g clip-path="url(#arte-clip-m)">
                  <rect class="arte__brillo" x="0" y="0" width="110" height="470"/>
                </g>
              </g>
            </g>
            <g class="arte__seleccion">
              <rect class="arte__marco" pathLength="100" x="80" y="150.2" width="480" height="363.6"/>
              <g class="arte__asas">
              <rect style="--i:0" x="75" y="145.2" width="10" height="10"/>
              <rect style="--i:1" x="315" y="145.2" width="10" height="10"/>
              <rect class="arte__asa-tocada" style="--i:2" x="555" y="145.2" width="10" height="10"/>
              <rect style="--i:3" x="555" y="327.0" width="10" height="10"/>
              <rect style="--i:4" x="555" y="508.8" width="10" height="10"/>
              <rect style="--i:5" x="315" y="508.8" width="10" height="10"/>
              <rect style="--i:6" x="75" y="508.8" width="10" height="10"/>
              <rect style="--i:7" x="75" y="327.0" width="10" height="10"/>
              </g>
              <g class="arte__medida">
                <g class="arte__sombra-ui" filter="url(#arte-elevacion-ui)">
                  <rect x="264" y="529" width="112" height="30" rx="8"/>
                  <text x="320" y="549.2">480 × 364</text>
                </g>
              </g>
            </g>
            <!-- El destello: una estrella de cuatro puntas que brilla un instante en
                 el pie derecho de la letra cuando el brillo termina de cruzarla. -->
            <path class="arte__destello" d="M536 488Q538 500 550 502Q538 504 536 516Q534 504 522 502Q534 500 536 488Z"/>
          </g>

          <!-- Delante del todo: el cursor de quien la toca, con su nombre. En escritorio
               sigue a tu cursor (arte__sigue). Llega en curva desde abajo, hace clic
               en la esquina de la selección (el anillo) y luego se mece. -->
          <g class="arte__capa arte__capa--cursor">
            <g class="arte__sigue">
              <circle class="arte__clic" cx="566" cy="160" r="15"/>
              <g class="arte__vuelo">
                <g class="arte__sombra-ui" filter="url(#arte-elevacion-ui)" transform="translate(566 160)">
                  <path class="arte__flecha" d="M0 0L0 22L6 16.8L9.8 26L13.8 24.3L10 15.4L17.5 15.4Z"/>
                  <rect class="arte__etiqueta" x="16" y="26" width="68" height="30" rx="9"/>
                  <text class="arte__nombre" x="50" y="45.6">Marc</text>
                </g>
              </g>
            </g>
          </g>
        </svg>
      </div>

      <div class={retratoHero ? 'hero__stage' : 'hero__stage hero__stage--sola'}>
        {retratoHero && (
          <figure class="portrait">
            <img src="/assets/marc.webp" alt="Retrato de Marc Amorós" width="1200" height="1600"
                 fetchpriority="high" decoding="async">
            <figcaption class="portrait__plate">
              <span class="portrait__name">Marc Amorós</span>
              <span class="portrait__role">El diseño como puente entre el usuario y el producto</span>
            </figcaption>
          </figure>
        )}

        <div class="stat-stack enter" style="--delay:480ms">
          <div class="stat">
            <span class="stat__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
              </svg>
            </span>
            <span class="stat__num" data-count="6">6</span>
            <span class="stat__label">Equipos y estudios por los que he pasado</span>
          </div>
          <div class="stat">
            <span class="stat__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <path d="M12 6v6l4 2"/>
              </svg>
            </span>
            <span class="stat__num" data-count="10">10</span>
            <span class="stat__label">Años diseñando experiencias</span>
          </div>
          <div class="stat">
            <span class="stat__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path fill="currentColor" d="M16.969 16.927a2.561 2.561 0 0 0 1.901.677 2.501 2.501 0 0 0 1.531-.475c.362-.235.636-.584.779-.99h2.585a5.091 5.091 0 0 1-1.9 2.896 5.292 5.292 0 0 1-3.091.88 5.839 5.839 0 0 1-2.284-.433 4.871 4.871 0 0 1-1.723-1.211 5.657 5.657 0 0 1-1.08-1.874 7.057 7.057 0 0 1-.383-2.393c-.005-.8.129-1.595.396-2.349a5.313 5.313 0 0 1 5.088-3.604 4.87 4.87 0 0 1 2.376.563c.661.362 1.231.87 1.668 1.485a6.2 6.2 0 0 1 .943 2.133c.194.821.263 1.666.205 2.508h-7.699c-.063.79.184 1.574.688 2.187ZM6.947 4.084a8.065 8.065 0 0 1 1.928.198 4.29 4.29 0 0 1 1.49.638c.418.303.748.711.958 1.182.241.579.357 1.203.341 1.83a3.506 3.506 0 0 1-.506 1.961 3.726 3.726 0 0 1-1.503 1.287 3.588 3.588 0 0 1 2.027 1.437c.464.747.697 1.615.67 2.494a4.593 4.593 0 0 1-.423 2.032 3.945 3.945 0 0 1-1.163 1.413 5.114 5.114 0 0 1-1.683.807 7.135 7.135 0 0 1-1.928.259H0V4.084h6.947Zm-.235 12.9c.308.004.616-.029.916-.099a2.18 2.18 0 0 0 .766-.332c.228-.158.411-.371.534-.619.142-.317.208-.663.191-1.009a2.08 2.08 0 0 0-.642-1.715 2.618 2.618 0 0 0-1.696-.505h-3.54v4.279h3.471Zm13.635-5.967a2.13 2.13 0 0 0-1.654-.619 2.336 2.336 0 0 0-1.163.259 2.474 2.474 0 0 0-.738.62 2.359 2.359 0 0 0-.396.792c-.074.239-.12.485-.137.734h4.769a3.239 3.239 0 0 0-.679-1.785l-.002-.001Zm-13.813-.648a2.254 2.254 0 0 0 1.423-.433c.399-.355.607-.88.56-1.413a1.916 1.916 0 0 0-.178-.891 1.298 1.298 0 0 0-.495-.533 1.851 1.851 0 0 0-.711-.274 3.966 3.966 0 0 0-.835-.073H3.241v3.631h3.293v-.014ZM21.62 5.122h-5.976v1.527h5.976V5.122Z"/></svg>
            </span>
            <span class="stat__num" data-count="9">9</span>
            <span class="stat__label">Proyectos publicados en Behance</span>
          </div>
          <div class="stat">
            <span class="stat__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path fill="currentColor" d="M4.21 0A4.201 4.201 0 0 0 0 4.21v15.58A4.201 4.201 0 0 0 4.21 24h15.58A4.201 4.201 0 0 0 24 19.79v-1.093c-.137.013-.278.02-.422.02-2.577 0-4.027-2.146-4.09-4.832a7.592 7.592 0 0 1 .022-.708c.093-1.186.475-2.241 1.105-3.022a3.885 3.885 0 0 1 1.395-1.1c.468-.237 1.127-.367 1.664-.367h.023c.101 0 .202.004.303.01V4.211A4.201 4.201 0 0 0 19.79 0Zm.198 5.583h4.165l3.588 8.435 3.59-8.435h3.864v.146l-.019.004c-.705.16-1.063.397-1.063 1.254h-.003l.003 10.274c.06.676.424.885 1.063 1.03l.02.004v.145h-4.923v-.145l.019-.005c.639-.144.994-.353 1.054-1.03V7.267l-4.745 11.15h-.261L6.15 7.569v9.445c0 .857.358 1.094 1.063 1.253l.02.004v.147H4.405v-.147l.019-.004c.705-.16 1.065-.397 1.065-1.253V6.987c0-.857-.358-1.094-1.064-1.254l-.018-.004zm19.25 3.668c-1.086.023-1.733 1.323-1.813 3.124H24V9.298a1.378 1.378 0 0 0-.342-.047Zm-1.862 3.632c-.1 1.756.86 3.239 2.204 3.634v-3.634z"/></svg>
            </span>
            <span class="stat__num" data-count="5">5</span>
            <span class="stat__label">Artículos de proceso en Medium</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       Sobre mí
       ============================================================ -->
  <section class="section section--sunk" id="sobre-mi" aria-labelledby="sobre-mi-titulo">
    <div class="container about__grid">
      <div class="section-head rise">
        <span class="eyebrow">Sobre mí</span>
        <h2 id="sobre-mi-titulo">El diseño como <span class="lema__puente">puente</span> entre el usuario y el producto</h2>
        <!-- El retrato con su tarjeta: el nombre y, debajo, el oficio. Ya no está en
             la portada: retratoHero, en src/lib/ajustes.js, lo devuelve allí. -->
        <figure class="portrait">
          <img src="/assets/marc.webp" alt="Retrato de Marc Amorós" width="1200" height="1600"
               loading="lazy" decoding="async">
          <figcaption class="portrait__plate">
            <span class="portrait__name">Marc Amorós</span>
            <span class="portrait__role">Diseñador UX/UI</span>
          </figcaption>
        </figure>
      </div>

      <div class="about__body rise" style="--delay:80ms">
        <p>
          Soy diseñador de producto UX/UI y vengo del diseño gráfico y la identidad de marca.
          Entiendo el diseño como una herramienta para resolver necesidades reales, no solo para
          crear interfaces atractivas.
        </p>

        <div class="metodo">
          <p class="about__k" id="metodo-titulo">Cómo trabajo</p>
          <ul class="metodo__lista" aria-labelledby="metodo-titulo">
            <li>Investigación previa antes de tocar Figma.</li>
            <li>Definición clara del problema.</li>
            <li>Validación con usuarios reales mediante prototipo.</li>
          </ul>
        </div>

        <!-- Versión completa (sobreMiCompleto, en src/lib/ajustes.js): la nota sobre
             documentar el proceso y los proyectos destacados, con enlace a cada caso. -->
        {sobreMiCompleto && (
          <>
            <p>
              Documento mi proceso en abierto (tests, storyboards y descartes) porque el valor del
              diseño está en las decisiones, no solo en el resultado visual.
            </p>

            <!-- Los mismos tres proyectos que abren el portafolio. -->
            <div class="destacados">
              <p class="about__k" id="destacados-titulo">Proyectos destacados</p>
              <ul class="destacados__lista" aria-labelledby="destacados-titulo">
                <li>
                  <a class="destacado" href="/proyecto/cupra-born/">
                    <span class="destacado__t">CUPRA Born</span>
                    <span class="destacado__d">Cuadro de instrumentos · EDAG</span>
                  </a>
                </li>
                <li>
                  <a class="destacado" href="/proyecto/portal-estadistico-notariado/">
                    <span class="destacado__t">Portal Estadístico del Notariado</span>
                    <span class="destacado__d">Producto de datos · Centro Tecnológico del Notariado</span>
                  </a>
                </li>
                <li>
                  <a class="destacado" href="/proyecto/portal-notarial-ciudadano/">
                    <span class="destacado__t">Portal Notarial del Ciudadano</span>
                    <span class="destacado__d">Administración electrónica · Centro Tecnológico del Notariado</span>
                  </a>
                </li>
              </ul>
            </div>
          </>
        )}

        <!-- Las tres áreas de trabajo: se quedan en las dos versiones. -->
        <div class="skills">
          <article class="skill">
            <h3>Investigación</h3>
            <p>Benchmarking, persona, mapa de empatía, user journey y evaluación heurística, hasta dar con el hallazgo que cambia una decisión.</p>
          </article>
          <article class="skill">
            <h3>Interfaz y sistema</h3>
            <p>Arquitectura de la información, jerarquía y estados, resueltos como componentes reutilizables en Figma para que la siguiente pantalla no empiece de cero.</p>
          </article>
          <article class="skill">
            <h3>Prototipo y validación</h3>
            <p>Storyboard, wireframes y prototipo interactivo, probados con usuarios para corregir lo que falla antes de que llegue a desarrollo.</p>
          </article>
        </div>

        <!-- Versión corta: cierra con dos líneas de texto. Versión completa: las
             mismas herramientas y metodologías en píldoras, con su rótulo. -->
        {sobreMiCompleto ? (
          <div class="herramientas">
            <div class="herramientas__grupo">
              <p class="about__k" id="herramientas-titulo">Herramientas</p>
              <ul class="toolbar" aria-labelledby="herramientas-titulo">
                <li>Adobe XD</li><li>CSS</li><li>Figma</li><li>Flinto</li><li>HTML</li><li>IA</li>
